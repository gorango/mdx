#!/usr/bin/env bash
set -euo pipefail

START="${1:?Usage: $0 START END [WORKERS] [OVERWRITE]}"
END="${2:?Usage: $0 START END [WORKERS] [OVERWRITE]}"
WORKERS="${3:-4}"
OVERWRITE="${4:-false}"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
SYMBOLS_FILE="$PROJECT_ROOT/config/symbols.yaml"

source "$SCRIPT_DIR/progress.sh"

# Read symbols from canonical config/symbols.yaml
mapfile -t SYMBOL_LIST < <(grep -oP '^\s*-\s+"\K[^"]+' "$SYMBOLS_FILE")

echo "Building ob-hydrate..."
BINARY=$(mktemp /tmp/ob-hydrate.XXXXXX)
go build -o "$BINARY" "$SCRIPT_DIR/../cmd/ob-hydrate"

FUNDING_CACHE=$(mktemp -d /tmp/ob-hydrate-funding.XXXXXX)
LOG_DIR=$(mktemp -d /tmp/hydrate-orderbook-logs.XXXXXX)
STATUS_FILE=$(mktemp /tmp/hydrate-orderbook-status.XXXXXX)
trap 'rm -rf "$BINARY" "$FUNDING_CACHE" "$STATUS_FILE" "$STATUS_FILE.stop"' EXIT

OVERWRITE_FLAG=""
if [ "$OVERWRITE" = "true" ]; then
	OVERWRITE_FLAG="-overwrite"
fi

# Default to --resume when not overwriting: ExistingHours batch skips the
# 61h already present and only fetches the tail, instead of re-streaming
# all 99h via gap-fill. Gap-fill is still available via OVERWRITE=true
# or by passing --resume explicitly through the just wrapper if needed.
RESUME_FLAG=""
if [ "$OVERWRITE" = "false" ]; then
	RESUME_FLAG="-resume"
fi

POOL_LABEL="orderbook $START→$END"
run_symbol() {
	"$BINARY" \
		-symbol "$1" \
		$OVERWRITE_FLAG \
		$RESUME_FLAG \
		-start "$START" \
		-end "$END" \
		-funding-cache "$FUNDING_CACHE"
}

echo "Hydrating ${#SYMBOL_LIST[@]} symbols from $START to $END with $WORKERS workers (overwrite=$OVERWRITE)"
echo "Per-symbol logs: $LOG_DIR"

FAILED=0
pool_run "${#SYMBOL_LIST[@]}" "$WORKERS" "$STATUS_FILE" "$LOG_DIR" "${SYMBOL_LIST[@]}" || FAILED=1

if ((FAILED)); then
	echo "Failed symbols:"
	pool_failures "$STATUS_FILE" | sed 's/^/  /'
	echo "Logs kept for inspection: $LOG_DIR"
	exit 1
fi

# A zero exit code does not mean clean data: per-hour failures are logged
# while the pipeline still exits 0 (e.g. vendor 404 skip-ahead). Keep logs
# whenever they carry real errors so silent skips are discoverable. Match
# slog LEVELS, not the word "error" — WARN lines carry an error="..." attr
# for routine, benign cases (e.g. liquidations parquet unavailable).
if grep -qliE 'level=(ERROR|FATAL)' "$LOG_DIR"/*.log 2>/dev/null; then
	echo "WARNING: errors in per-symbol logs (kept): $LOG_DIR"
	grep -liE 'level=(ERROR|FATAL)' "$LOG_DIR"/*.log | sed 's/^/  /'
else
	rm -rf "$LOG_DIR"
fi
